# Copy privately to /opt/kubepanel/.env (chmod 600).
# Set a strong initial password for a new installation. Existing accounts persist in DATA_DIR.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Optional: persisted automatically in data/.jwt-secret when empty. Never log this value.
DASHBOARD_SECRET=
DASHBOARD_TOKEN_TTL=12h
BASE_DIR=/opt/kubepanel
# IP+port access retained. Set 127.0.0.1 for a local HTTPS reverse proxy later.
BIND_ADDRESS=0.0.0.0
HOST_PORT=9090
TRUST_PROXY=false
BUILD_REVISION=development
SOURCE_MANIFEST_SHA256=development
