# 复制为 .env 后修改：cp .env.example .env（docker compose / --env-file 都会自动读取）
# .env 已在 .gitignore 里，不会被提交

# 登录密码：至少 12 位，建议含大小写/数字/符号。留空则启动时随机生成，并打印在 docker logs 里。
DASHBOARD_PASSWORD=

# JWT 签名密钥：可以不填。留空时首次启动自动生成，存在数据目录的 .jwt-secret（0600），重启后复用；
# 只有多副本共享会话、或想自己掌控密钥时才需要显式指定：openssl rand -hex 32
DASHBOARD_SECRET=
